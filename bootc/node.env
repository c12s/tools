# c12s node defaults, shipped in the OS image at /usr/lib/c12s/node.env.
#
# The same for every node, so they travel with the image: change a value,
# build a new image, roll it out. A wrong control-plane address rolls itself
# back (greenboot 02-cp-reachability.sh fails on the update boot).
#
# Per-node values (VM_NETWORK, VM_IP_BASE on a VM host) and local overrides
# live in /var/lib/c12s/node.env, written once by cloud-init. star.service
# loads that file after this one, so a key set there wins.
NATS_ADDRESS=192.168.122.1:4222
# OS image registry (host:port): short refs like os/edge-base:v1.1 from the
# control plane are pulled from here; a ref naming a host overrides it.
# Must match an insecure entry in registries.conf.d (Containerfile).
IMAGE_REGISTRY=192.168.122.1:5001
# disk registry (artifact server, qcow2 files): VM disks given by name are
# fetched from here. Not the OCI registry (:5001), which holds OS images.
DISK_REGISTRY_URL=http://192.168.122.1:8081
NODE_ID_DIR_PATH=/var/lib/c12s
NODE_ID_FILE_NAME=nodeid
REGISTRATION_REQ_TIMEOUT_MILLISECONDS=10000
MAX_REGISTRATION_RETRIES=3
BIND_ADDRESS=0.0.0.0
BIND_PORT=7946
STAR_ADDRESS=:11000
OS_POLL_INTERVAL=30s
